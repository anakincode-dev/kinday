[Unit]
Description=Kinday - ежедневный бэкап базы данных
Documentation=https://github.com/anakincode-dev/kinday

[Service]
Type=oneshot
User=kinday
Group=kinday
WorkingDirectory=/opt/kinday
ExecStart=/opt/kinday/.venv/bin/python -m kinday.backup
Environment=DATABASE_PATH=/var/lib/kinday/kinday.db
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/kinday

[Install]
WantedBy=timers.target
