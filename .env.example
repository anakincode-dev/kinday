# Скопируй в .env и заполни. .env в git не попадает (см. .gitignore).

# Токен бота из @BotFather. Обязателен, без него сервис не стартует.
BOT_TOKEN=

# Путь к файлу SQLite. По умолчанию kinday.sqlite3 в рабочей директории.
DATABASE_PATH=kinday.sqlite3

# Уровень логирования: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
