{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format_py.sh",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run ty:*)",
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(git push origin --force:*)",
      "Bash(git push origin --force-with-lease:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin +:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin --force:*)",
      "Bash(git push -u origin --force-with-lease:*)",
      "Bash(git push -u origin -f:*)",
      "Bash(git push -u origin +:*)",
      "Bash(git push -u origin main:*)"
    ]
  }
}
